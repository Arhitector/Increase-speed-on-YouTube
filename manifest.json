{
  "name": "Youtube speederman",
  "version": "2.0.0",
  "description": "increase video speed",
  "manifest_version": 3,
  "author": "Architector",
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.pornhub.com/*",
        "*://xhamster.com/*",
        "*://*.xhamster.com/*",
        "https://es.xhamster.com/*",
        "https://ua.xhamster.com/*"
      ],
      "js": [
       "./node_modules/@webcomponents/webcomponentsjs/webcomponents-bundle.js",
       "config.js",
       "content.js"
    ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "increase video speed"
  },
  "icons": {
    "16": "./assets/images.png",
    "48": "./assets/images.png",
    "128": "./assets/images.png"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles.css"], 
      "matches": ["<all_urls>"]
    }
  ]
}
